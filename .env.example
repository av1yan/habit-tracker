# Copy to .env and fill in from your Supabase project (Settings → API).
# Only the anon/publishable key belongs here — never the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Optional: Sentry crash/error reporting. Leave unset to disable (e.g. in Expo Go).
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX

# Optional: PostHog product analytics. Leave unset to disable — analytics is inert
# without a key (events only log to the dev console), and users can still opt out
# in-app (Profile → Share usage data). Host defaults to https://us.i.posthog.com.
# EXPO_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
