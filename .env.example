# Copy to .env and fill in from your Supabase project (Settings → API).
# Only the anon/publishable key belongs here — never the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Optional: Sentry crash/error reporting. Leave unset to disable (e.g. in Expo Go).
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
